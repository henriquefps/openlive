{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlive.invalid/protocol/v1/messages/stream.announce.json",
  "title": "StreamAnnounceMessage",
  "description": "The helper has published tracks to the SFU and announces the stream.",
  "x-openlive": {
    "phase": 2,
    "channels": ["room"],
    "from": ["helper"],
    "to": ["server"],
    "replies": ["stream.started", "error"]
  },
  "type": "object",
  "properties": {
    "type": { "const": "stream.announce" },
    "id": { "$ref": "../envelope.json#/$defs/MessageId" },
    "payload": { "$ref": "#/$defs/StreamAnnouncePayload" }
  },
  "required": ["type", "payload"],
  "additionalProperties": false,
  "$defs": {
    "StreamAnnouncePayload": {
      "title": "StreamAnnouncePayload",
      "type": "object",
      "properties": {
        "sfuSessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source": { "$ref": "../common.json#/$defs/SourceInfo" },
        "preset": { "$ref": "../common.json#/$defs/Preset" },
        "tracks": {
          "type": "array",
          "items": { "$ref": "../common.json#/$defs/Track" },
          "minItems": 1,
          "maxItems": 4
        },
        "hasAudio": { "type": "boolean" },
        "viewerLimit": {
          "type": "integer",
          "minimum": 0,
          "description": "Streamer's own limit; the room's limit applies when absent or higher."
        },
        "layers": {
          "$ref": "../common.json#/$defs/VideoLayers",
          "description": "The layers as encoded (since 1.19); on stream.update, sent with a new preset."
        },
        "pingOverlay": {
          "type": "boolean",
          "description": "The helper can draw pointer pings over the shared screen (since 1.20). Absent means false."
        }
      },
      "required": ["sfuSessionId", "source", "preset", "tracks", "hasAudio"],
      "additionalProperties": false
    }
  }
}

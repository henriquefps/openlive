{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlive.invalid/protocol/v1/messages/helper.offline.json",
  "title": "HelperOfflineMessage",
  "description": "One of the user's helpers disconnected.",
  "x-openlive": { "phase": 3, "channels": ["hub"], "from": ["server"], "to": ["web"] },
  "type": "object",
  "properties": {
    "type": { "const": "helper.offline" },
    "id": { "$ref": "../envelope.json#/$defs/MessageId" },
    "payload": { "$ref": "#/$defs/HelperOfflinePayload" }
  },
  "required": ["type", "payload"],
  "additionalProperties": false,
  "$defs": {
    "HelperOfflinePayload": {
      "title": "HelperOfflinePayload",
      "type": "object",
      "properties": { "deviceId": { "$ref": "../common.json#/$defs/Id" } },
      "required": ["deviceId"],
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlive.invalid/protocol/v1/messages/ack.json",
  "title": "AckMessage",
  "description": "Success reply for requests that have no specific reply type.",
  "x-openlive": {
    "phase": 1,
    "channels": ["room", "hub"],
    "from": ["server"],
    "to": ["web", "helper"]
  },
  "type": "object",
  "properties": {
    "type": { "const": "ack" },
    "id": { "$ref": "../envelope.json#/$defs/MessageId" },
    "payload": { "$ref": "#/$defs/AckPayload" }
  },
  "required": ["type", "payload"],
  "additionalProperties": false,
  "$defs": {
    "AckPayload": {
      "title": "AckPayload",
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  }
}

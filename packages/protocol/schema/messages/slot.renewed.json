{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlive.invalid/protocol/v1/messages/slot.renewed.json",
  "title": "SlotRenewedMessage",
  "description": "The lease was extended.",
  "x-openlive": { "phase": 1, "channels": ["room"], "from": ["server"], "to": ["web"] },
  "type": "object",
  "properties": {
    "type": { "const": "slot.renewed" },
    "id": { "$ref": "../envelope.json#/$defs/MessageId" },
    "payload": { "$ref": "#/$defs/SlotRenewedPayload" }
  },
  "required": ["type", "payload"],
  "additionalProperties": false,
  "$defs": {
    "SlotRenewedPayload": {
      "title": "SlotRenewedPayload",
      "type": "object",
      "properties": {
        "slotId": { "$ref": "../common.json#/$defs/Id" },
        "expiresAt": { "$ref": "../common.json#/$defs/UnixMs" }
      },
      "required": ["slotId", "expiresAt"],
      "additionalProperties": false
    }
  }
}

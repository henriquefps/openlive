{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlive.invalid/protocol/v1/messages/chat.deleted.json",
  "title": "ChatDeletedMessage",
  "description": "A chat message was deleted: the reply to chat.delete (with its id) and an event to everyone else (since 1.11). Clients drop it; the room keeps no text of it.",
  "x-openlive": {
    "phase": 6,
    "channels": ["room"],
    "from": ["server"],
    "to": ["web"]
  },
  "type": "object",
  "properties": {
    "type": {
      "const": "chat.deleted"
    },
    "id": {
      "$ref": "../envelope.json#/$defs/MessageId"
    },
    "payload": {
      "$ref": "#/$defs/ChatDeletedPayload"
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false,
  "$defs": {
    "ChatDeletedPayload": {
      "title": "ChatDeletedPayload",
      "type": "object",
      "properties": {
        "messageId": {
          "$ref": "../common.json#/$defs/Id"
        }
      },
      "required": ["messageId"],
      "additionalProperties": false
    }
  }
}

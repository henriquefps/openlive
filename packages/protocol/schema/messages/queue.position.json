{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlive.invalid/protocol/v1/messages/queue.position.json",
  "title": "QueuePositionMessage",
  "description": "Position in the queue of a full stream (1 = next). Sent on join and whenever it changes.",
  "x-openlive": { "phase": 1, "channels": ["room"], "from": ["server"], "to": ["web"] },
  "type": "object",
  "properties": {
    "type": { "const": "queue.position" },
    "id": { "$ref": "../envelope.json#/$defs/MessageId" },
    "payload": { "$ref": "#/$defs/QueuePositionPayload" }
  },
  "required": ["type", "payload"],
  "additionalProperties": false,
  "$defs": {
    "QueuePositionPayload": {
      "title": "QueuePositionPayload",
      "type": "object",
      "properties": {
        "streamId": { "$ref": "../common.json#/$defs/Id" },
        "position": { "type": "integer", "minimum": 1 },
        "length": { "type": "integer", "minimum": 1 }
      },
      "required": ["streamId", "position", "length"],
      "additionalProperties": false
    }
  }
}

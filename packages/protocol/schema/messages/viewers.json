{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlive.invalid/protocol/v1/messages/viewers.json",
  "title": "ViewersMessage",
  "description": "Who holds a slot on a stream and how many slots exist. Sent to every member when it changes.",
  "x-openlive": { "phase": 1, "channels": ["room"], "from": ["server"], "to": ["web", "helper"] },
  "type": "object",
  "properties": {
    "type": { "const": "viewers" },
    "id": { "$ref": "../envelope.json#/$defs/MessageId" },
    "payload": { "$ref": "#/$defs/ViewersPayload" }
  },
  "required": ["type", "payload"],
  "additionalProperties": false,
  "$defs": {
    "ViewersPayload": {
      "title": "ViewersPayload",
      "type": "object",
      "properties": {
        "streamId": { "$ref": "../common.json#/$defs/Id" },
        "viewerUserIds": {
          "type": "array",
          "items": { "$ref": "../common.json#/$defs/Id" },
          "uniqueItems": true
        },
        "used": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 0 },
        "queueLength": { "type": "integer", "minimum": 0 }
      },
      "required": ["streamId", "viewerUserIds", "used", "limit", "queueLength"],
      "additionalProperties": false
    }
  }
}

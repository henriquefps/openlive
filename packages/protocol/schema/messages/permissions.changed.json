  "$id": "https://openlive.invalid/protocol/v1/messages/permissions.changed.json",
  "title": "PermissionsChangedMessage",
  "description": "The receiving connection's role or permissions changed; applied immediately, without waiting for the next request.",
  "x-openlive": { "phase": 1, "channels": ["room"], "from": ["server"], "to": ["web", "helper"] },
  "type": "object",
  "properties": {
    "type": { "const": "permissions.changed" },
    "id": { "$ref": "../envelope.json#/$defs/MessageId" },
    "payload": { "$ref": "#/$defs/PermissionsChangedPayload" }
  },
  "required": ["type", "payload"],
  "additionalProperties": false,
  "$defs": {
    "PermissionsChangedPayload": {
      "title": "PermissionsChangedPayload",
      "type": "object",
      "properties": { "you": { "$ref": "../common.json#/$defs/You" } },
      "required": ["you"],
      "additionalProperties": false
    }
  }
}

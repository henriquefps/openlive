{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlive.invalid/protocol/v1/messages/member.updated.json",
  "title": "MemberUpdatedMessage",
  "description": "A present user's role or stream permission changed.",
  "x-openlive": { "phase": 1, "channels": ["room"], "from": ["server"], "to": ["web", "helper"] },
  "type": "object",
  "properties": {
    "type": { "const": "member.updated" },
    "id": { "$ref": "../envelope.json#/$defs/MessageId" },
    "payload": { "$ref": "#/$defs/MemberUpdatedPayload" }
  },
  "required": ["type", "payload"],
  "additionalProperties": false,
  "$defs": {
    "MemberUpdatedPayload": {
      "title": "MemberUpdatedPayload",
      "type": "object",
      "properties": { "member": { "$ref": "../common.json#/$defs/Member" } },
      "required": ["member"],
      "additionalProperties": false
    }
  }
}

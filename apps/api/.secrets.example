# Template for the secrets of a deployed environment. `pnpm run setup -- --env <env>` copies it
# to .secrets.<env> (git-ignored, mode 0600) and uploads the values with the deploy.
# Names only here; never commit values. See docs/self-host.md.

# Filled in by you. At least one login method: the Discord pair, or the Resend key.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
RESEND_API_KEY=

# Filled in by the setup. Leave empty on the first run.
SESSION_SECRET=
INSTALL_CODE=
REALTIME_APP_ID=
REALTIME_APP_TOKEN=
TURN_KEY_ID=
TURN_KEY_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional.
# API token with Account > Account Analytics > Read: the usage cron copies real egress into D1.
CLOUDFLARE_API_TOKEN=
# Verifies helper updates (a later phase).
HELPER_UPDATE_SIGNING_PUBKEY=

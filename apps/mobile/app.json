{
  "expo": {
    "name": "Openlive",
    "slug": "openlive",
    "version": "0.1.0",
    "scheme": "openlive",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f4f4f0",
    "android": {
      "package": "dev.hfps.openlive",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5b7a3a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.BLUETOOTH"
      ]
    },
    "ios": {
      "bundleIdentifier": "dev.hfps.openlive",
      "supportsTablet": false
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Openlive uses the camera to scan an instance's QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-localization",
      "@config-plugins/react-native-webrtc",
      "./plugins/with-openlive-audio.js",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# react-native-webrtc 155: the AAR ships the dav1d JNI wrapper without its generated Natives class; the decoder itself is native.\n-dontwarn org.webrtc.Dav1dDecoder$Natives"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf"
          ]
        }
      ]
    ]
  }
}
